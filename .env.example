EMAIL="admin@example.com"
DOMAIN="example.com"

# URL of this CA's published CRL. Certificates this CA signs name this URL.
# A sub-CA .env names that sub-CA's CRL. The root certificate itself has none.
CRL_URL="http://mail.example.com/root-ca.crl.pem"

# Certificate expiry thresholds in days
ROOT_CA_THRESHOLD=90
SUB_CA_THRESHOLD=60
CERT_THRESHOLD=30
